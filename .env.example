# 线上 / 本地统一推荐使用 PostgreSQL（例如 Neon）
# 例：postgresql://user:password@host/database?sslmode=require
DATABASE_URL="postgresql://your-user:your-password@your-host/your-db?sslmode=require"

# 如果你只想本地临时跑 SQLite，也可以临时改成：
# DATABASE_URL="file:./dev.db"

# 邮件发送驱动：
#   - console: 把验证码打印到 pnpm dev 控制台（本地开发用）
#   - resend: 真实发邮件（生产推荐，需自有域名）
#   - smtp: 通过个人邮箱 SMTP 发邮件（现在立刻就能给朋友测试）
MAIL_DRIVER="console"

# Resend（可选）
# 如果要切成真实邮箱登录，把 re_xxxxxxxxx 换成你自己的 Resend API Key
RESEND_API_KEY="re_xxxxxxxxx"
# 已在 Resend 验证过的发件邮箱，例如：noreply@your-domain.com
# MAIL_FROM="noreply@your-domain.com"

# QQ 邮箱 SMTP（推荐你当前阶段用这个）
# MAIL_DRIVER="smtp"
# SMTP_HOST="smtp.qq.com"
# SMTP_PORT="465"
# SMTP_SECURE="true"
# SMTP_USER="你的QQ邮箱@qq.com"
# SMTP_PASS="你的SMTP授权码"
# MAIL_FROM="你的QQ邮箱@qq.com"

# Used by scripts/generate-image.mjs. A raw key in root openai.key also works.
OPENAI_API_KEY="sk-proj-your-openai-api-key"
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_IMAGE_MODEL="gpt-image-2"
