# SQLite 数据文件路径（注意：相对路径是相对 prisma/schema.prisma 解析的）
DATABASE_URL="file:./dev.db"

# 邮件发送驱动：
#   - console: 把验证码打印到 pnpm dev 控制台（本地开发用）
#   - 后续会扩展 resend / smtp 等
MAIL_DRIVER="console"

# Used by scripts/generate-image.mjs. A raw key in root openai.key also works.
OPENAI_API_KEY="sk-proj-your-openai-api-key"
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_IMAGE_MODEL="gpt-image-2"
